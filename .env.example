VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WHATSAPP_NUMBER=5492494621182

# URL publica del sitio usada por Supabase Auth para mails de confirmacion.
# En produccion: https://autos-tandil.vercel.app (o tu dominio final), sin slash final.
VITE_SITE_URL=

# Admin temporal MVP. NO es seguridad real para produccion.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=admin

# Solo scripts/agente/migraciones. Nunca frontend.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Subastas =====
# Email del admin para que el script supabase:apply-auctions lo registre como admin.
# Antes, dale alta de cuenta en /subastas (Crear cuenta) o desde el dashboard de Supabase.
AUCTIONS_ADMIN_EMAIL=

# ===== MercadoPago (server-only para /api/mp/*) =====
# Public key para futuras integraciones frontend (por ejemplo Bricks). Checkout Pro actual no la necesita.
MP_PUBLIC_KEY=
VITE_MP_PUBLIC_KEY=
# Token desde https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
# URL publica del sitio (Vercel) para back_urls y notification_url. Sin slash final.
PUBLIC_BASE_URL=
# Server-side mirror del SUPABASE_URL para los handlers /api/* (suele ser igual a VITE_SUPABASE_URL)
SUPABASE_URL=
